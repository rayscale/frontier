{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "#/*": ["./source/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "source/**/*.ts",
    "source/**/*.tsx",
    "content/**/*.ts",
    "content/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/build", "**/coverage", ".next", "out"]
}
