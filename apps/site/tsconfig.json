{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./source/*"]
    }
  },
  "include": [
    "source/**/*.ts",
    "source/**/*.tsx",
    "content/**/*.ts",
    "content/**/*.tsx",
    "vite.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/build", "**/coverage"]
}
