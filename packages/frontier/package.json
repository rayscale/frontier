{
  "name": "@rayscale/frontier",
  "version": "0.0.0",
  "description": "A design language for the web.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./symbol-metadata": {
      "types": "./dist/symbols/metadata.generated.d.ts",
      "import": "./dist/symbols/metadata.generated.js"
    },
    "./theme-metadata": {
      "types": "./dist/themes/themes.generated.d.ts",
      "import": "./dist/themes/themes.generated.js"
    },
    "./themes.css": "./dist/styles/themes/index.css",
    "./themes/*.css": "./dist/styles/themes/*.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:symbols": "node --experimental-strip-types scripts/generate-symbols.ts && pnpm exec prettier --write \"source/symbols/components/**/*.{ts,tsx}\" \"source/symbols/generated.ts\"",
    "generate:themes": "node --experimental-strip-types scripts/generate-themes.ts && pnpm exec prettier --write source/themes/themes.generated.ts source/styles/themes/index.css",
    "prebuild": "node -e \"for (const path of ['source/symbols/components', 'source/symbols/generated.ts', 'source/symbols/metadata.generated.ts', 'source/themes/themes.generated.ts', 'source/styles/themes/index.css']) require('node:fs').rmSync(path, { force: true, recursive: true })\" && pnpm generate:symbols && pnpm generate:themes",
    "build": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-xml-parser": "^5.12.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "motion": "^14.14.0",
    "shiki": "^4.6.0"
  }
}
