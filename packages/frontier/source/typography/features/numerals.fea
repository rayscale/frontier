feature tnum {
  sub zero by zero.tf;
  sub one by one.tf;
  sub two by two.tf;
  sub three by three.tf;
  sub four by four.tf;
  sub five by five.tf;
  sub six by six.tf;
  sub seven by seven.tf;
  sub eight by eight.tf;
  sub nine by nine.tf;
} tnum;

feature pnum {
  sub zero.tf by zero;
  sub one.tf by one;
  sub two.tf by two;
  sub three.tf by three;
  sub four.tf by four;
  sub five.tf by five;
  sub six.tf by six;
  sub seven.tf by seven;
  sub eight.tf by eight;
  sub nine.tf by nine;
} pnum;

feature zero {
  sub zero by zero.zero;
  sub zero.tf by zero.tf.zero;
} zero;
